<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>4.48</version>
    <relativePath />
  </parent>

  <artifactId>maven-repo-cleaner</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>hpi</packaging>
  <name>Maven Repository Scheduled Cleanup Plugin</name>
  <url>https://wiki.jenkins-ci.org/display/JENKINS/Maven+Repo+Cleaner+Plugin</url>

  <properties>
    <revision>1.3</revision>
    <changelist>-SNAPSHOT</changelist>
    <gitHubRepo>jenkinsci/${project.artifactId}</gitHubRepo>
    <jenkins.version>2.332.1</jenkins.version>

    <!--TODO: change to true after the code cleanup-->
    <spotbugs.failOnError>false</spotbugs.failOnError>
    <!-- well the parent pom could defined an empty one instead of causing failure!! -->
    <argLine />
    
    <!-- Version of the project (same as in version tag). It will be updated automatically by GEBIT flow. -->
    <version.maven-repo-cleaner>1.3</version.maven-repo-cleaner>
    <version.property>version.maven-repo-cleaner</version.property>
    
    <project.build-name>maven-repo-cleaner</project.build-name>
    <project.jira>DINF</project.jira>
    
    <!-- Version of gebit-build to be used -->
    <version.build>3.4.1-I377</version.build>
    <version.gebit-build-extension>1.2.2</version.gebit-build-extension>
    <version.tiles>2.8-gebit37</version.tiles>
    <version.gitflow-maven-plugin>2.4.6-I152</version.gitflow-maven-plugin>
    
    <tiles.applyBefore>org.jenkins-ci.plugins:maven-repo-cleaner</tiles.applyBefore>
    <tiles.mergeTarget>${tiles.applyBefore}</tiles.mergeTarget>
    
    <flow.skipReleaseBranchMerge>true</flow.skipReleaseBranchMerge>
    
    <version.java>${java.version}</version.java>
    <java.version>11</java.version>
  </properties>



  <scm>
   <connection>scm:git:git://github.com/jenkinsci/maven-repo-cleaner-plugin.git</connection>
   <developerConnection>scm:git:git@github.com:jenkinsci/maven-repo-cleaner-plugin.git</developerConnection>
   <url>https://github.com/jenkinsci/maven-repo-cleaner-plugin</url>
    <tag>HEAD</tag>
  </scm>

  <developers>
    <developer>
      <id>abayer</id>
      <name>Andrew Bayer</name>
      <email>andrew.bayer@gmail.com</email>
      <timezone>-8</timezone>
    </developer>
    <developer>
      <id>olamy</id>
      <name>Olivier Lamy</name>
    </developer>
  </developers>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-2.332.x</artifactId>
        <version>1607.va_c1576527071</version>
        <scope>import</scope>
        <type>pom</type>
      </dependency>
      <dependency>
        <groupId>javax.annotation</groupId>
        <artifactId>javax.annotation-api</artifactId>
        <version>1.3.2</version>
      </dependency>
      <dependency>
        <groupId>commons-net</groupId>
        <artifactId>commons-net</artifactId>
        <version>3.8.0</version>
      </dependency>
      <dependency>
        <groupId>org.jenkins-ci.plugins</groupId>
        <artifactId>junit</artifactId>
        <version>1119.1121.vc43d0fc45561</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.apache.ant</groupId>
      <artifactId>ant</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jenkins-ci.main</groupId>
      <artifactId>maven-plugin</artifactId>
      <version>3.19</version>
    </dependency>
    <dependency>
      <groupId>commons-io</groupId>
      <artifactId>commons-io</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-repository-metadata</artifactId>
      <version>3.8.3</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.indexer</groupId>
      <artifactId>indexer-artifact</artifactId>
      <version>5.1.1</version>
    </dependency>
  </dependencies>

	<!-- gebit: we cannot override the distributionManagement from our build tile
			 see: https://jira.gebit.de/browse/GBLD-1099 -->
  <!-- <distributionManagement>
     fix maven3 warning for id local
    <snapshotRepository>
      prevent accidental deployment of SNAPSHOTS to repository
      <id>local.repository</id>
      <url>file:.</url>
    </snapshotRepository>
  </distributionManagement> -->

  <!-- get every artifact through maven.glassfish.org, which proxies all the artifacts that we need -->
  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
      <releases>
         <enabled>false</enabled>
      </releases>
      <snapshots>
      	<enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>incrementals</id>
      <url>https://repo.jenkins-ci.org/incrementals/</url>
      <releases>
      	<enabled>false</enabled>
      </releases>
      <snapshots>
      	<enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
      <releases>
         <enabled>false</enabled>
      </releases>
      <snapshots>
      	<enabled>false</enabled>
      </snapshots>
    </pluginRepository>
    <pluginRepository>
      <id>incrementals</id>
      <url>https://repo.jenkins-ci.org/incrementals/</url>
      <releases>
      	<enabled>false</enabled>
      </releases>
      <snapshots>
      	<enabled>false</enabled>
      </snapshots>
  	</pluginRepository>
  </pluginRepositories>

	<build>
		<plugins>
			<plugin>
		     <groupId>io.repaint.maven</groupId>
		     <artifactId>tiles-maven-plugin</artifactId>
		     <version>${version.tiles}</version>
		     <extensions>true</extensions>
		     <configuration>
	       	<applyBefore>${tiles.applyBefore}</applyBefore>
	        <mergeTarget>${tiles.mergeTarget}</mergeTarget>
	        <tiles combine.children="append">
	        	<tile>de.gebit.build.tile:build:${version.build}</tile>
	          <!-- hier can be added other tiles to be used -->
	        </tiles>
	      </configuration>
	 		</plugin>
		</plugins>
		<extensions>
	  	<extension>
	    	<groupId>de.gebit.build.maven</groupId>
	    	<artifactId>gebit-build-extension</artifactId>
	    	<version>${version.gebit-build-extension}</version>
			</extension>
		</extensions>
	</build>

</project>
